generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(uuid())
  telegramId            BigInt             @unique @map("telegram_id")
  username              String?
  firstName             String?            @map("first_name")
  lastName              String?            @map("last_name")
  photoUrl              String?            @map("photo_url")
  role                  Role               @default(user)
  walletAddress         String?            @map("wallet_address")
  totalTasksCompleted   Int                @default(0) @map("total_tasks_completed")
  totalWins             Int                @default(0) @map("total_wins")
  totalRewardsAmount    Decimal            @default(0) @map("total_rewards_amount") @db.Decimal(18, 6)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  walletAddressFriendly String?            @map("wallet_address_friendly")
  participations        QuestParticipant[]
  quests                Quest[]            @relation("QuestCreator")
  rewards               Reward[]
  taskSubmissions       TaskSubmission[]
  walletConnections     WalletConnection[]

  @@map("users")
}

model Quest {
  id                String             @id @default(uuid())
  title             String
  shortDescription  String?            @map("short_description")
  fullDescription   String?            @map("full_description")
  rules             String?
  startDate         DateTime?          @map("start_date")
  endDate           DateTime?          @map("end_date")
  status            QuestStatus        @default(draft)
  participantsCount Int                @default(0) @map("participants_count")
  createdBy         String?            @map("created_by")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  participants      QuestParticipant[]
  creator           User?              @relation("QuestCreator", fields: [createdBy], references: [id])
  rewardAmountPerWinner Decimal? @map("reward_amount_per_winner") @db.Decimal(18, 6)
  winnersCount          Int      @default(3) @map("winners_count")
  rewards           Reward[]
  submissions       TaskSubmission[]
  tasks             Task[]

  @@map("quests")
}

model QuestParticipant {
  id            String            @id @default(uuid())
  questId       String            @map("quest_id")
  userId        String            @map("user_id")
  score         Int               @default(0)
  rank          Int?
  joinedAt      DateTime          @default(now()) @map("joined_at")
  completedAt   DateTime?         @map("completed_at")
  status        ParticipantStatus @default(joined)
  isWinner      Boolean           @default(false) @map("is_winner")
  rewardClaimed Boolean           @default(false) @map("reward_claimed")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  quest         Quest             @relation(fields: [questId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questId, userId])
  @@map("quest_participants")
}

model Task {
  id            String           @id @default(uuid())
  questId       String           @map("quest_id")
  title         String
  description   String?
  taskType      TaskType         @default(quiz) @map("task_type")
  correctAnswer String?          @map("correct_answer")
  points        Int              @default(10)
  orderIndex    Int              @default(0) @map("order_index")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  options       Json?
  submissions   TaskSubmission[]
  quest         Quest            @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model TaskSubmission {
  id              String   @id @default(uuid())
  taskId          String   @map("task_id")
  userId          String   @map("user_id")
  questId         String   @map("quest_id")
  submittedAnswer String?  @map("submitted_answer")
  isCorrect       Boolean  @default(false) @map("is_correct")
  pointsAwarded   Int      @default(0) @map("points_awarded")
  submittedAt     DateTime @default(now()) @map("submitted_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  quest           Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_submissions")
}

model Reward {
  id              String       @id @default(uuid())
  questId         String       @map("quest_id")
  userId          String       @map("user_id")
  amount          Decimal      @default(0) @db.Decimal(18, 6)
  rewardType      RewardType   @default(ton) @map("reward_type")
  status          RewardStatus @default(pending)
  transactionHash String?      @map("transaction_hash")
  distributedAt   DateTime?    @map("distributed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  contractAddress String?      @map("contract_address")
  processingAt    DateTime?    @map("processing_at")
  quest           Quest        @relation(fields: [questId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("rewards")
}

model WalletConnection {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  walletAddress String   @map("wallet_address")
  providerName  String   @default("TON Connect") @map("provider_name")
  isActive      Boolean  @default(true) @map("is_active")
  connectedAt   DateTime @default(now()) @map("connected_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_connections")
}

enum Role {
  user
  admin
}

enum QuestStatus {
  draft
  active
  completed
  cancelled
}

enum ParticipantStatus {
  joined
  in_progress
  completed
  disqualified
}

enum TaskType {
  quiz
  multiple_choice
}

enum RewardType {
  ton
  nft
  off_chain
}

enum RewardStatus {
  pending
  distributed
  failed
  processing
}
